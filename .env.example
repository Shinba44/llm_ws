# このファイルを .env にコピーして値を埋める。.env はコミットされない。
# cp .env.example .env

# --- ローカル推論基盤（A0） ---
# 本プロジェクトは商用APIを使わない（docs/00_PLAN.md §9）。
# Ollama もしくは llama.cpp server の OpenAI互換エンドポイントを指す。
#
#   Ollama          : http://localhost:11434/v1
#   llama.cpp server: http://localhost:8080/v1
#
# ノートPCから GPU機の推論サーバを叩く場合は、localhost をGPU機のIPに置き換える。
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen3:8b

# OpenAI互換クライアントは何らかのキー文字列を要求するが、
# ローカルサーバは検証しないのでダミーでよい。
AGENT_API_KEY=local

# --- 埋め込みモデル（A2 / ローカル実行） ---
EMBED_MODEL=intfloat/multilingual-e5-small

# --- モデル重みのキャッシュ ---
# 複数環境でダウンロード済みの重みを共有する
HF_HOME=

# --- 実験管理（B3以降） ---
WANDB_API_KEY=
HF_TOKEN=

# --- 例外: SFTデータ合成のみ（B6） ---
# エージェント本体の常用には使わない。詳細は docs/00_PLAN.md §9
SYNTH_BASE_URL=
SYNTH_API_KEY=
SYNTH_MODEL=
