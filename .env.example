# このファイルを .env にコピーして値を埋める。.env はコミットされない。
# cp .env.example .env

# --- LLMプロバイダ（使うものだけ設定） ---
# Anthropic API
ANTHROPIC_API_KEY=

# OpenAI互換API（OpenAI / ローカルサーバ / その他）
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Ollama（ローカル）
OLLAMA_HOST=http://localhost:11434

# エージェントが使うモデル
AGENT_PROVIDER=anthropic
AGENT_MODEL=claude-sonnet-5

# --- 外部ツール（A4以降） ---
# Web検索
TAVILY_API_KEY=
BRAVE_API_KEY=

# --- 実験管理（B3以降） ---
WANDB_API_KEY=
HF_TOKEN=
